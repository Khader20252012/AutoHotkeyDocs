; AutoClickSliderBox.ahk
; This script clicks when a vertical slider line overlaps with a moving gray box.
; Created for dynamic UI where box and slider positions are not fixed.

; Set the timer to run the check 20 times per second
SetTimer, CheckSlider, 50
return

CheckSlider:
{
    ; === USER CONFIGURATION REQUIRED ===
    ; Set these to the actual colors (in RGB format) using the ShowPixelColor helper script
    sliderColor := 0xFFFFFF   ; Example: White vertical line
    boxColor := 0x7F7F7F      ; Example: Medium gray box

    ; === Find the slider line position on the screen ===
    PixelSearch, sliderX, sliderY, 0, 0, A_ScreenWidth, A_ScreenHeight, sliderColor, 5, Fast RGB
    if (ErrorLevel)
        return  ; Slider not found, skip this cycle

    ; === Find the box position on the screen ===
    PixelSearch, boxX, boxY, 0, 0, A_ScreenWidth, A_ScreenHeight, boxColor, 10, Fast RGB
    if (ErrorLevel)
        return  ; Box not found, skip this cycle

    ; === Check if slider is inside or touching the box area ===
    ; You may adjust the range depending on your UI
    if (
        sliderX >= boxX - 5 and sliderX <= boxX + 50
     and sliderY >= boxY - 10 and sliderY <= boxY + 40
    ) {
        Click  ; Perform the click
    }
}
